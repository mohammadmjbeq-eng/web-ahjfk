{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ahjfk",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d7698437-c75d-4038-94b4-9cc19d83902d","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f692fb4a70f1463392e2e0f4012cbfeb" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
